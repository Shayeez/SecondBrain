[Unit]
Description=Second Brain Sovereign Web & RAG Service
After=network.target

[Service]
Type=simple
User=app_test
WorkingDirectory=/home/app_test/SecondBrain
EnvironmentFile=-/home/app_test/SecondBrain/.env
ExecStart=/home/app_test/SecondBrain/.venv/bin/python -m second_brain.main

Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
