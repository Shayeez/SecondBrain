<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.secondbrain.server</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Replace with path to your python executable in virtualenv -->
        <string>/Users/REPLACE_WITH_USERNAME/SecondBrain/.venv/bin/python</string>
        <string>-m</string>
        <string>second_brain.main</string>
    </array>

    <key>WorkingDirectory</key>
    <!-- Replace with path to your SecondBrain repository -->
    <string>/Users/REPLACE_WITH_USERNAME/SecondBrain</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_WITH_USERNAME/Library/Logs/SecondBrain.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_WITH_USERNAME/Library/Logs/SecondBrain.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
