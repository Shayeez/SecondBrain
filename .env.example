# Second Brain Configuration Template
# Copy this file to .env and fill in your values

# External AI Cloud APIs
GEMINI_API_KEY="your-gemini-api-key"


# Independent Web Auth
BRAIN_AUTH_TOKEN="brain-secret-vault-key-2026"

# Local LLM on VPS (Default: connects to local Ollama on loopback)
LOCAL_LLM_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_LLM_MODEL="qwen2.5:1.5b"
LOCAL_LLM_API_KEY="ollama"
USE_LOCAL_LLM="true"

# Server Network Settings
# Set WEB_PORT to an unused port on your VPS (e.g. 8020) if 8000 is occupied
WEB_HOST="127.0.0.1"
WEB_PORT="8020"

# Storage Directories
# On VPS under app_test user:
STORAGE_DIR="/home/app_test/SecondBrain/storage/Raw_Inbox"
CHROMA_DIR="/home/app_test/SecondBrain/chroma_db"


