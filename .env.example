# ==============================================================================
# Second Brain - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment (Mac, VPS, or PC).

# --- 1. Cloud AI Multimodal Keys (Required) ---
GEMINI_API_KEY="your-gemini-api-key-here"

# --- 2. Authentication Passphrase ---
# Master admin token (individual user tokens are configured in users.json)
BRAIN_AUTH_TOKEN="brain-secret-vault-key-2026"

# Zero-Click Auto-Login (Single-User Convenience Mode)
# Set to "true" for zero-click instant access on your private machine / local Mac
AUTO_LOGIN_ENABLED="false"
# AUTO_LOGIN_USER="shayeez"  # Defaults to primary/first user in users.json

# --- 3. Local LLM Settings (Ollama on macOS, Linux VPS, or Windows) ---
# When Ollama is running locally (e.g. `ollama serve` or Ollama.app on Mac):
LOCAL_LLM_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_LLM_MODEL="qwen2.5:1.5b"
LOCAL_LLM_API_KEY="ollama"
USE_LOCAL_LLM="true"

# --- 4. Web Server Settings ---
WEB_HOST="127.0.0.1"
WEB_PORT="8020"

# --- 5. Storage Folder Configurations ---
# Primary storage root directory where user vaults, notes, and media are kept.
# macOS example:        STORAGE_BASE_DIR="~/SecondBrain"
# macOS Google Drive:   STORAGE_BASE_DIR="~/Library/CloudStorage/GoogleDrive-user@gmail.com/My Drive/SecondBrain"
# Linux VPS example:    STORAGE_BASE_DIR="/home/app_test/SecondBrain/storage"
# Windows example:      STORAGE_BASE_DIR="C:/SecondBrain"
STORAGE_BASE_DIR="~/SecondBrain"

# Optional subfolder overrides (leave commented to use standard defaults):
# STORAGE_RAW_DIR="~/SecondBrain/Raw_Inbox"
# STORAGE_WIKI_DIR="~/SecondBrain/Processed_Wiki"
# USERS_STORAGE_DIR="~/SecondBrain/users"
# USERS_DATA_FILE="~/SecondBrain/users.json"

# --- 6. ChromaDB Vector Database Storage ---
# IMPORTANT: Store ChromaDB on local fast SSD disk (do NOT store directly inside Google Drive sync folders)
# macOS local default:   CHROMA_DIR="~/Library/Application Support/SecondBrain/chroma_db"
# Project local default: CHROMA_DIR="./chroma_db"
CHROMA_DIR="./chroma_db"

# Optional ChromaDB Client/Server Mode (for high-concurrency multi-worker deployments)
# Leave blank to use embedded SQLite mode (default)
# CHROMA_SERVER_HOST="127.0.0.1"
# CHROMA_SERVER_PORT="8000"

# --- 7. Cross-Platform Local Machine File Search (Windows, Mac, Linux) ---
# Comma-separated list of directories on your computer to index for instant file search & inspection
# macOS / Linux default: ~/Documents,~/Downloads,~/Desktop
# Windows example:       C:/Users/name/Documents,C:/Users/name/Downloads
# LOCAL_SEARCH_DIRS="~/Documents,~/Downloads,~/Desktop"
# LOCAL_INDEX_DB_PATH="./storage/file_index.sqlite3"
